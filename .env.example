# Supabase — get these from your project dashboard:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Identity Engine (server-only)
# mock | claude | auto — invalid values are rejected at generation time.
# Production (NODE_ENV=production) refuses to run on the mock provider unless
# IDENTITY_ENGINE_ALLOW_MOCK=true is set explicitly; a missing mode, a typo, or
# auto mode without an API key fails closed instead of persisting mock output.
IDENTITY_ENGINE_MODE=mock
ANTHROPIC_API_KEY=
# Optional override
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# IDENTITY_ENGINE_TIMEOUT_MS=30000
# IDENTITY_ENGINE_ALLOW_MOCK=true

# Observability (server-only, optional). Background failures are always logged
# as structured [error-report] lines; set a webhook (Slack, Discord, any JSON
# collector) to also receive them in real time.
# ERROR_REPORTING_WEBHOOK_URL=

# AI spend protection (server-only, optional). Each user may consume this many
# real (non-mock) AI generations per UTC day; enforced only in production.
# Defaults to 200. AI_QUOTA_BYPASS_USER_IDS exempts admin accounts
# (comma-separated auth user ids).
# AI_DAILY_GENERATION_LIMIT=200
# AI_QUOTA_BYPASS_USER_IDS=
